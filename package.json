{
  "name": "ai-office-studio",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n studio,runner -c blue,magenta \"next dev\" \"tsx watch runner/index.ts\"",
    "dev:web": "next dev",
    "dev:runner": "tsx watch runner/index.ts",
    "runner": "tsx runner/index.ts",
    "validate": "tsc --noEmit",
    "test": "tsx --tsconfig tsconfig.json --test tests/*.test.ts",
    "lint": "eslint .",
    "build": "npm run validate && npm run test && next build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "dexie": "^4.4.7",
    "geist": "latest",
    "jszip": "^3.10.2",
    "lucide-react": "^1.77.0",
    "next": "latest",
    "openai": "^7.62.0",
    "pixi.js": "^8.23.0",
    "react": "latest",
    "react-dom": "latest",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.7",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "tsx": "^4.23.15",
    "typescript": "latest"
  }
}
